linters: all_linters(
    line_length_linter(120L),
    cyclocomp_linter = NULL,
    todo_comment_linter = NULL,
    implicit_integer_linter = NULL,
    nonportable_path_linter = NULL,
    paste_linter = NULL,
    strings_as_factors_linter = NULL,
    object_overwrite_linter = NULL,
    object_name_linter = NULL,
    condition_call_linter = NULL,
    expect_identical_linter = NULL,
    implicit_assignment_linter = NULL,
    unnecessary_lambda_linter = NULL,
    undesirable_function_linter(fun = modify_defaults(
      defaults = default_undesirable_functions,
      structure = NULL,
      par = NULL,
      options = NULL
    ))
  )
exclusions: list(
    "tests/testthat.R",
    "tests" = list(undesirable_operator_linter = Inf),
    "vignettes" = list(
      library_call_linter = Inf,
      redundant_ifelse_linter = Inf,
      undesirable_function_linter = Inf
    )
  )
