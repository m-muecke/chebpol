#!/bin/sh
# Finds the optional libraries FFTW and GSL with pkg-config and writes
# src/Makevars. Without FFTW the Chebyshev transform uses a slower matrix
# method; without GSL stalker splines need a uniform grid.
#
# Skip a library with
#   R CMD INSTALL --configure-args='--disable-fftw --disable-gsl'
# or set its flags by hand with
#   R CMD INSTALL --configure-vars='FFTW_CFLAGS=... FFTW_LIBS=...'
# (likewise GSL_CFLAGS and GSL_LIBS).

use_fftw=yes
use_gsl=yes
for arg in "$@"; do
  case "$arg" in
    --disable-fftw) use_fftw=no ;;
    --disable-gsl) use_gsl=no ;;
  esac
done

: "${R_HOME=$(R RHOME)}"
CC=$("${R_HOME}/bin/R" CMD config CC)
CFLAGS=$("${R_HOME}/bin/R" CMD config CFLAGS)
CPPFLAGS=$("${R_HOME}/bin/R" CMD config CPPFLAGS)
LDFLAGS=$("${R_HOME}/bin/R" CMD config LDFLAGS)

# try_link <header> <call> <cflags> <libs>: can a program using the library be built?
try_link() {
  printf '#include <%s>\nint main(void) { %s; return 0; }\n' "$1" "$2" > conftest.c
  # shellcheck disable=SC2086
  ${CC} ${CPPFLAGS} ${CFLAGS} $3 conftest.c ${LDFLAGS} $4 -o conftest >> configure.log 2>&1
  status=$?
  rm -rf conftest conftest.c conftest.o conftest.dSYM
  return $status
}

# find_lib <name> <pkg-config module> <header> <call> <packages to install>
# Sets have_lib, lib_cflags and lib_libs.
find_lib() {
  have_lib=no
  eval "lib_cflags=\${$1_CFLAGS-}"
  eval "lib_libs=\${$1_LIBS-}"
  if [ -z "$lib_cflags" ] && [ -z "$lib_libs" ]; then
    if pkg-config --exists "$2" 2> /dev/null; then
      lib_cflags=$(pkg-config --cflags "$2")
      lib_libs=$(pkg-config --libs "$2")
    else
      echo "* $1: not found by pkg-config. To use it, install $5."
      return
    fi
  fi
  if try_link "$3" "$4" "$lib_cflags" "$lib_libs"; then
    have_lib=yes
    echo "* $1: using cflags '$lib_cflags' and libs '$lib_libs'"
  else
    echo "* $1: found, but a test program did not build (see configure.log). Not using it."
    lib_cflags=
    lib_libs=
  fi
}

: > configure.log
defs=
cflags=
libs=

if [ "$use_fftw" = yes ]; then
  find_lib FFTW fftw3 fftw3.h 'fftw_cleanup()' \
    'libfftw3-dev (deb), fftw-devel (rpm) or fftw (brew)'
  if [ "$have_lib" = yes ]; then
    defs="$defs -DHAVE_FFTW"
    cflags="$cflags $lib_cflags"
    libs="$libs $lib_libs"
  fi
else
  echo "* FFTW: disabled"
fi

if [ "$use_gsl" = yes ]; then
  find_lib GSL gsl gsl/gsl_roots.h 'gsl_root_fsolver_alloc(gsl_root_fsolver_brent)' \
    'libgsl-dev (deb), gsl-devel (rpm) or gsl (brew)'
  if [ "$have_lib" = yes ]; then
    defs="$defs -DHAVE_GSL"
    cflags="$cflags $lib_cflags"
    libs="$libs $lib_libs"
  fi
else
  echo "* GSL: disabled"
fi

sed -e "s|@defs@|$defs|" -e "s|@cflags@|$cflags|" -e "s|@libs@|$libs|" \
  src/Makevars.in > src/Makevars
