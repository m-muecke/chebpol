ph2 <- ipol(f, knots = knots, k = 2, method = "polyharmonic")
# make 7 points in R3 to test them on
m <- matrix(runif(3 * 7), 3)
rbind(
  true = apply(m, 2, f),
  ml = ml2(m),
  fh = fh2(m),
  cheb = ch2(m),
  poly = ph2(m),
  hst = hst(m)
)
